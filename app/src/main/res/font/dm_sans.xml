<?xml version="1.0" encoding="utf-8"?>
<!--
    DM Sans font family — same files bundled by Projectivy Launcher.
    Regular (400) + Bold (700) cover all weights used by the app.
    The app: namespace attributes provide AppCompat back-compat for API < 26.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/dm_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/dm_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/dm_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/dm_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
