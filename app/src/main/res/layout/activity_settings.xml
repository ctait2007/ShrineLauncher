<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/bg_dark">

    <!-- Left nav column -->
    <LinearLayout android:layout_width="180dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#111111"
        android:paddingTop="24dp" android:paddingBottom="16dp" android:paddingStart="16dp">

        <TextView android:id="@+id/navRows"
            style="@style/NavItem" android:text="Categories" />
        <TextView android:id="@+id/navAppearance"
            style="@style/NavItem" android:text="Appearance" />
        <TextView android:id="@+id/navExport"
            style="@style/NavItem" android:text="Export" />
        <TextView android:id="@+id/navInstaller"
            style="@style/NavItem" android:text="Installer" />

        <View android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/btnBack"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="← Back" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:paddingVertical="12dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Right content panels -->
    <ScrollView android:id="@+id/rightPanel"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:scrollbars="none"
        android:descendantFocusability="afterDescendants">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <!-- ══ CATEGORIES PANEL ═══════════════════════════════════════════ -->
            <LinearLayout android:id="@+id/panelRows"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Categories" android:textColor="@color/text_primary"
                    android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRows"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView android:id="@+id/btnAddRow" style="@style/SettingsActionBtn"
                    android:text="+ Add Row" android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- ══ APPEARANCE PANEL ══════════════════════════════════════════ -->
            <LinearLayout android:id="@+id/panelAppearance"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Appearance" android:textColor="@color/text_primary"
                    android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Icons -->
                <TextView style="@style/SettingsSectionHeading" android:text="Icons" />

                <TextView style="@style/FieldLabel" android:text="Icon Size" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/btnSizeS" android:layout_width="0dp"
                        android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:text="S"
                        android:textColor="@color/text_primary" android:textSize="16sp"
                        android:textStyle="bold" android:focusable="true"
                        android:background="@drawable/selector_size_btn"
                        android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/btnSizeM" android:layout_width="0dp"
                        android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:text="M"
                        android:textColor="@color/text_primary" android:textSize="16sp"
                        android:textStyle="bold" android:focusable="true"
                        android:background="@drawable/selector_size_btn"
                        android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/btnSizeL" android:layout_width="0dp"
                        android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:text="L"
                        android:textColor="@color/text_primary" android:textSize="16sp"
                        android:textStyle="bold" android:focusable="true"
                        android:background="@drawable/selector_size_btn"
                        android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/btnSizeXL" android:layout_width="0dp"
                        android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:text="XL"
                        android:textColor="@color/text_primary" android:textSize="16sp"
                        android:textStyle="bold" android:focusable="true"
                        android:background="@drawable/selector_size_btn" />
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="Corner Roundness" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <SeekBar android:id="@+id/sbCornerRadius" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:max="10" android:focusable="true" />
                    <TextView android:id="@+id/tvCornerRadiusValue" android:layout_width="44dp"
                        android:layout_height="wrap_content" android:textColor="@color/accent"
                        android:textSize="12sp" android:gravity="center"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Layout Position -->
                <TextView style="@style/SettingsSectionHeading" android:text="Layout" />

                <TextView style="@style/FieldLabel" android:text="Bottom Margin" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <SeekBar android:id="@+id/sbBottomMargin" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:max="90" android:focusable="true" />
                    <TextView android:id="@+id/tvBottomMarginValue" android:layout_width="44dp"
                        android:layout_height="wrap_content" android:textColor="@color/accent"
                        android:textSize="12sp" android:gravity="center"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView style="@style/FieldLabel" android:text="Start Margin" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <SeekBar android:id="@+id/sbRowStartPadding" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:max="100" android:focusable="true" />
                    <TextView android:id="@+id/tvRowStartPaddingValue" android:layout_width="44dp"
                        android:layout_height="wrap_content" android:textColor="@color/accent"
                        android:textSize="12sp" android:gravity="center"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Wallpaper -->
                <TextView style="@style/SettingsSectionHeading" android:text="Wallpaper" />

                <FrameLayout android:layout_width="match_parent" android:layout_height="160dp"
                    android:layout_marginBottom="12dp" android:background="#111111"
                    android:id="@+id/wallpaperFrame">
                    <ImageView android:id="@+id/ivWallpaperPreview"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop" android:contentDescription="Wallpaper preview" />
                    <TextView android:id="@+id/tvWallpaperNone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center" android:text="No wallpaper set"
                        android:textColor="@color/text_secondary" android:textSize="12sp" />
                </FrameLayout>

                <!-- Single wallpaper -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/btnPickWallpaper"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Choose Image" android:textColor="@color/text_primary"
                        android:textSize="14sp" android:textStyle="bold"
                        android:focusable="true" android:background="@drawable/bg_btn_primary"
                        android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/btnClearWallpaper"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Clear" android:textColor="#EF5350"
                        android:textSize="14sp" android:focusable="true"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>

                <!-- Slideshow -->
                <TextView style="@style/FieldLabel" android:text="Slideshow"
                    android:layout_marginTop="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Pick multiple images to cycle through as a slideshow"
                    android:textColor="@color/text_secondary" android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/btnPickSlideshow"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Choose Images" android:textColor="@color/text_primary"
                        android:textSize="14sp" android:textStyle="bold"
                        android:focusable="true" android:background="@drawable/bg_btn_primary"
                        android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/btnClearSlideshow"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Clear" android:textColor="#EF5350"
                        android:textSize="14sp" android:focusable="true"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>

                <TextView android:id="@+id/tvSlideshowCount"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary" android:textSize="11sp"
                    android:layout_marginBottom="8dp" android:text="No slideshow configured" />

                <TextView style="@style/FieldLabel" android:text="Slideshow Interval" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <SeekBar android:id="@+id/sbSlideshowInterval"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:max="5" android:focusable="true" />
                    <TextView android:id="@+id/tvSlideshowIntervalValue"
                        android:layout_width="56dp" android:layout_height="wrap_content"
                        android:textColor="@color/accent" android:textSize="12sp"
                        android:gravity="center" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Date & Time -->
                <TextView style="@style/SettingsSectionHeading" android:text="Date &amp; Time" />

                <LinearLayout style="@style/SwitchRow">
                    <TextView style="@style/SwitchLabel" android:text="Show Clock" />
                    <Switch android:id="@+id/switchClock"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/SwitchRow">
                    <TextView style="@style/SwitchLabel" android:text="Show Date" />
                    <Switch android:id="@+id/switchDate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/SwitchRow" android:layout_marginBottom="16dp">
                    <TextView style="@style/SwitchLabel" android:text="24-hour Format" />
                    <Switch android:id="@+id/switch24h"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Single save button -->
                <TextView android:id="@+id/btnSaveAppearance" style="@style/SettingsActionBtn"
                    android:text="Save Configuration" android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <!-- ══ EXPORT PANEL ══════════════════════════════════════════════ -->
            <LinearLayout android:id="@+id/panelExport"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Export / Import" android:textColor="@color/text_primary"
                    android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Export all settings, rows, and appearance to a file. Import to restore a previous configuration."
                    android:textColor="@color/text_secondary" android:textSize="12sp"
                    android:layout_marginBottom="20dp" />

                <TextView style="@style/SettingsSectionHeading" android:text="Local File" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:layout_marginBottom="20dp">
                    <TextView android:id="@+id/btnExportConfig"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Export Config" android:textColor="@color/text_primary"
                        android:textSize="14sp" android:textStyle="bold"
                        android:focusable="true" android:background="@drawable/bg_btn_primary"
                        android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/btnImportConfig"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Import Config" android:textColor="@color/accent"
                        android:textSize="14sp" android:focusable="true"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>

                <TextView style="@style/SettingsSectionHeading" android:text="Cloud / Share" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Share your config via any app (Drive, email, clipboard, etc.)"
                    android:textColor="@color/text_secondary" android:textSize="12sp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/btnCloudExport"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Share Config" android:textColor="@color/text_primary"
                        android:textSize="14sp" android:textStyle="bold"
                        android:focusable="true" android:background="@drawable/bg_btn_primary"
                        android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/btnCloudImport"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center"
                        android:text="Paste Config" android:textColor="@color/accent"
                        android:textSize="14sp" android:focusable="true"
                        android:background="@drawable/bg_btn_secondary" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
