<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/rowItemRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:paddingHorizontal="8dp"
        android:descendantFocusability="afterDescendants"
        android:focusable="false">

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:focusable="false">

            <TextView
                android:id="@+id/tvSettingsRowName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:focusable="false" />

            <TextView
                android:id="@+id/tvSettingsRowType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:focusable="false" />

            <TextView
                android:id="@+id/tvSettingsRowMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:focusable="false" />
        </LinearLayout>

        <!-- Focusable action buttons -->
        <ImageButton
            android:id="@+id/btnToggleDisplayMode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_grid"
            android:background="@drawable/selector_focusable_item"
            android:tint="@color/accent"
            android:contentDescription="Toggle display mode"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnToggleVisibility"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_visibility_on"
            android:background="@drawable/selector_focusable_item"
            android:tint="@color/text_secondary"
            android:contentDescription="Toggle visibility"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnEditRow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_edit"
            android:background="@drawable/selector_focusable_item"
            android:tint="@color/text_secondary"
            android:contentDescription="Edit"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnDeleteRow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/selector_focusable_item"
            android:tint="#EF5350"
            android:contentDescription="Delete"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Subtle divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#11FFFFFF"
        android:layout_marginHorizontal="8dp" />

</LinearLayout>
