<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark"
    android:padding="32dp" android:gravity="center_horizontal">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="App Installer" android:textColor="@color/text_primary"
        android:textSize="24sp" android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Install APKs silently via URL or local file"
        android:textColor="@color/text_secondary" android:textSize="13sp"
        android:layout_marginBottom="32dp" />

    <!-- URL install -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="INSTALL FROM URL" android:textColor="@color/text_secondary"
        android:textSize="11sp" android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <EditText android:id="@+id/etApkUrl"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="https://example.com/app.apk"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="12dp"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <TextView android:id="@+id/btnInstallFromUrl"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center" android:text="Download &amp; Install"
        android:textColor="@color/text_primary" android:textSize="15sp"
        android:textStyle="bold" android:focusable="true"
        android:background="@drawable/bg_btn_outline"
        android:layout_marginBottom="32dp" />

    <!-- File picker -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="INSTALL FROM FILE" android:textColor="@color/text_secondary"
        android:textSize="11sp" android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView android:id="@+id/btnPickApk"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center" android:text="Browse for APK"
        android:textColor="@color/text_primary" android:textSize="15sp"
        android:focusable="true" android:background="@drawable/bg_btn_outline"
        android:layout_marginBottom="32dp" />

    <!-- Status -->
    <ProgressBar android:id="@+id/progressInstall"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:layout_marginBottom="12dp" />

    <TextView android:id="@+id/tvInstallStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:layout_marginBottom="24dp" />

    <TextView android:id="@+id/btnInstallerClose"
        android:layout_width="wrap_content" android:layout_height="44dp"
        android:gravity="center" android:paddingHorizontal="24dp"
        android:text="Close" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:focusable="true"
        android:background="@drawable/selector_focusable_item" />

</LinearLayout>
