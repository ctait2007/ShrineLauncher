<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header: opaque -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF1A1A1A"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/ivPanelLogo"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:src="@drawable/banner"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="Shrine Launcher" />

        <TextView
            android:id="@+id/tvPanelDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:text="Mon Jun 1, 2026" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF" />

    <!-- Body: translucent -->
    <ScrollView
        android:id="@+id/panelScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#801A1A1A"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
