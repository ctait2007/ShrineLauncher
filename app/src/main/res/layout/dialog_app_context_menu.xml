<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/ivAppIconMenu"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitCenter"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAppNameMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#22FFFFFF" android:layout_marginBottom="8dp"/>

    <TextView android:id="@+id/btnOpen"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center" android:text="Open"
        android:textColor="@color/text_primary" android:textSize="14sp"
        android:textStyle="bold" android:focusable="true"
        android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/btnToggleFavourite"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:gravity="center" android:text="Add to Favourites"
        android:textColor="@color/text_primary" android:textSize="13sp"
        android:focusable="true" android:layout_marginBottom="2dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#22FFFFFF" android:layout_marginVertical="8dp"/>

    <TextView android:id="@+id/btnAppInfo"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:gravity="center" android:text="App Info"
        android:textColor="@color/text_secondary" android:textSize="13sp"
        android:focusable="true" android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/btnForceStop"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:gravity="center" android:text="Force Stop"
        android:textColor="#FFA000" android:textSize="13sp"
        android:focusable="true" android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/btnUninstall"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:gravity="center" android:text="Uninstall"
        android:textColor="#EF5350" android:textSize="13sp"
        android:focusable="true" android:layout_marginBottom="8dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#22FFFFFF" android:layout_marginBottom="8dp"/>

    <TextView android:id="@+id/btnCancel"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:gravity="center" android:text="Cancel"
        android:textColor="@color/text_secondary" android:textSize="13sp"
        android:focusable="true" />

</LinearLayout>
