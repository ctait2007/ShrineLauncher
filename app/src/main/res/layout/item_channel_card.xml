<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/channelCardRoot"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivChannelArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_card_placeholder" />

        <View
            android:id="@+id/channelFocusOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <ProgressBar
            android:id="@+id/pbChannelProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvChannelTitle"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvChannelSubtitle"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:visibility="invisible" />

</LinearLayout>
