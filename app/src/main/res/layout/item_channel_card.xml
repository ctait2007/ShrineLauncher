<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp">

    <LinearLayout
        android:id="@+id/channelCardRoot"
        android:layout_width="200dp"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/bg_cw_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivChannelArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_card_placeholder" />

            <!-- Focus glow overlay -->
            <View
                android:id="@+id/channelFocusOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selector_focus_ring"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Info bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvChannelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvChannelSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/pbChannelProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="#44FFFFFF"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
