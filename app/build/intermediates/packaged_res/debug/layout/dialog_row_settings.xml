<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvRowSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Row Title"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etRowSettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:textColor="@color/text_primary"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:focusable="true" />

    <TextView
        android:id="@+id/tvRowAppsHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apps — drag to reorder • swipe left/right to remove"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRowSettingsApps"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnRowSettingsClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:focusable="true"
            android:background="@drawable/selector_focusable_item"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/btnRowSettingsSave"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Save"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="24dp"
            android:gravity="center"
            android:focusable="true"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
